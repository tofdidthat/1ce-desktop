{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "1CE Desktop",
  "version": "0.2.0-alpha.1",
  "identifier": "lol.onece.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "1CE Desktop",
        "width": 1160,
        "height": 760,
        "minWidth": 850,
        "minHeight": 620,
        "backgroundColor": "#111114"
      }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
